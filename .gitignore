# Python Virtual Environments
.venv/
venv/
ENV/
env/

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class

# Testing & Linting
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Build & Distribution
build/
dist/
*.egg-info/
*.egg

# Environment variables & secrets
.env
.env.*
*.local

# Database & log files
*.sqlite3
*.db
*.log

# Local tutorial production materials and private preview copies
/logsentinel/portal/static/tutorials
/docs/
/scripts/build_tutorials.py
/scripts/tutorial_capture.py
/scripts/tutorials_smoke.py
/.github/workflows/pages.yml

# Things a running portal or an installer leaves behind, and things that must
# never be committed by accident: keys, enrollment packages (single-use codes),
# backups (they hold the original logs and the access key) and local agent files.
access-key.txt
*.pem
*.key
alta*.json
backups/
notifications/
.claude/
