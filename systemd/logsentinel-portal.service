[Unit]
Description=LogSentinel local log review portal
After=network.target

[Service]
Type=simple
ExecStart=%h/security-agent/.venv/bin/logsentinel portal --data-dir %h/.local/share/logsentinel/portal --port 8766
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
